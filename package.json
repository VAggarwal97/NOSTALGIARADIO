{
  "name": "nostalgia-radio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nostalgia Radio — a modern single-screen public listening experience with an old Indian radio/cassette soul.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build",
    "ci": "npm run validate:content && npm test && tsc -b && npm run smoke && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.mjs",
    "smoke": "node scripts/smoke-render.mjs",
    "lint:security": "node scripts/validate-content.mjs --strict",
    "demo:audio": "node scripts/generate-demo-audio.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
